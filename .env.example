# Copy to .env for local dev. In production these are set via /opt/laya/.env
# and the compose file (see deploy notes).

NODE_ENV=development

# Port the app listens on INSIDE the container/process.
# Compose maps host 3080 -> this port.
PORT=8080

# Postgres connection string.
# Local dev example (matches docker-compose.dev.yml):
DATABASE_URL=postgresql://laya:laya@localhost:5432/laya?schema=public

# Master secret for the admin API (machine-to-machine key management).
# Send as: Authorization: Bearer <this>  (or X-Admin-Secret: <this>)
LAYA_ADMIN_SECRET=change-me-to-a-long-random-string

# Portal login (single admin user, seeded on first boot).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-min-8-chars

# Secret used to sign the admin session cookie.
SESSION_SECRET=change-me-to-a-long-random-string

# Where Laya caches its ~1.7 GB model weights.
# In the container this points at a chowned named volume (e.g. /data/laya).
# Leave unset in dev to use the default (~/.cache/receptron-laya).
# LAYA_CACHE=/data/laya
