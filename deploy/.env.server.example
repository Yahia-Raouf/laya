# Copy this to the server as /opt/laya/.env and fill in real secrets.
# The deploy workflow PRESERVES these lines and only updates the IMAGE= line,
# so your secrets are set once and stay put.
#
# Generate strong values, e.g.:  openssl rand -hex 32

# --- Postgres container ---
POSTGRES_USER=laya
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=laya

# --- App ---
# host is the compose service name "postgres"; password MUST match the one above
DATABASE_URL=postgresql://laya:REPLACE_WITH_STRONG_PASSWORD@postgres:5432/laya?schema=public
LAYA_ADMIN_SECRET=REPLACE_WITH_LONG_RANDOM
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM

# IMAGE is written automatically by the deploy workflow; no need to set it.
# IMAGE=ghcr.io/yahia-raouf/<repo>/app:<sha>
